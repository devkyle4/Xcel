# Copy to backend/.env for local development. Never commit real values.

# Runtime connection. Local: system Postgres (see scripts/db-setup.sql).
# Production (Vercel): Neon *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgres://xcel:xcel@localhost:5432/xcel

# Direct (unpooled) connection used only by drizzle-kit migrations.
# Local: same as DATABASE_URL. Neon: the non-pooler host.
DATABASE_URL_UNPOOLED=postgres://xcel:xcel@localhost:5432/xcel
