{
  "name": "@xcel/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/run.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/admin.ts create",
    "admin:reset-password": "tsx --env-file-if-exists=.env src/scripts/admin.ts reset-password",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@xcel/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
